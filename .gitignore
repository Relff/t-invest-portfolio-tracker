# macOS
.DS_Store

# Windows
Thumbs.db

# IDE / Редакторы
.idea/
.vscode/
*.swp
*.swo

# Google Apps Script (если когда-нибудь будешь использовать clasp)
.clasp.json
.claspignore

# Конфиги clasp с конкретными Script ID (template/personal) — personal
# указывает на личный боевой скрипт, не для публичного репозитория.
.clasp.template.json
.clasp.personal.json

# Скрипт пуша в личный боевой скрипт — держи локально, не для публичного
# репозитория (упоминает существование личного аккаунта в паре с template).
push-personal.sh

# Вызывает push-personal.sh — тоже личный, не для публичного репозитория.
push-all.sh

# Временные и бэкап файлы
*.tmp
*.bak
*~

# Логи
*.log
